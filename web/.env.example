# Copy this file to .env for local development. .env is git-ignored.
# Every variable is optional: the app builds and serves without a database.

# PostgreSQL 18 connection string, for `pnpm run db:generate`, `pnpm run db:migrate`
# and, once a feature stores data, the app. Any local database you own will do.
# DATABASE_URL="postgres://USER:PASSWORD@127.0.0.1:5432/feltprep_dev"

# `pnpm run start` (node build) only: the URL the server is reached at.
# Without it adapter-node assumes https.
# ORIGIN=http://127.0.0.1:3000

# Optional: the revision /healthz reports. By default the build uses the
# checkout's HEAD commit.
# FELTPREP_REVISION=
