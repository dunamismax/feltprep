{
	"name": "feltprep-web",
	"version": "0.0.1",
	"description": "FeltPrep: learn, study and practice No-Limit Texas Hold'em",
	"license": "AGPL-3.0-or-later",
	"private": true,
	"type": "module",
	"engines": {
		"node": "26.13.1"
	},
	"packageManager": "pnpm@12.18.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.ts",
		"engine:fuzz": "node scripts/engine-fuzz.ts",
		"engine:bench": "node scripts/engine-bench.ts",
		"engine:parity": "node scripts/engine-parity.ts",
		"equity:build": "node scripts/equity-build.ts",
		"jof:build": "node scripts/jam-or-fold-build.ts",
		"solver:bench": "node scripts/solver-bench.ts"
	},
	"dependencies": {
		"drizzle-orm": "0.45.4",
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.1",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-node": "6.0.5",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"@vitest/browser-playwright": "5.1.1",
		"drizzle-kit": "0.31.11",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"playwright": "1.65.1",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.58.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"vitest-browser-svelte": "3.1.0"
	}
}
